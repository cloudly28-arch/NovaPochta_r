+}
+
+void SimulationScreen::refreshSelectedStoreData()
+{
+    selectedStoreName_.clear();
+    selectedStoreInventory_.clear();
+
+    if (
+        backend_ == nullptr ||
+        !backend_->isReady() ||
+        selectedStoreId_ < 0
+    )
+    {
+        return;
+    }
+
+    selectedStoreName_ =
+        backend_->getStoreName(selectedStoreId_);
+
+    selectedStoreInventory_ =
+        backend_->getStoreInventory(selectedStoreId_);
+}
